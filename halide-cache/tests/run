#!/bin/bash

# ---------- SETUP ----------

builder=$1

die() {
    if (( $# == 1 )); then
        printf '%s\n' "$1"
    elif (( $# > 1 )); then
        printf "$@"
    fi >&2
    exit 1
}

test_dir=$(mktemp -d) &&
mkdir -p "$test_dir"/{cache,outputs,inputs,dependencies,temp} || exit
echo "Using test directory: $test_dir"

# The builder script uses these to change its output. It reads them directly
# and are not part of the command line
export HALIDE_TEST_DEPENDENCIES="$test_dir/dependencies"

configure_output() {
    echo "$1" > "$HALIDE_TEST_DEPENDENCIES/case.txt"
    echo "$2" > "$HALIDE_TEST_DEPENDENCIES/direction.txt"
}

# Usage: run_builder_with_cache <input> [extra halide-cache args...]
#
# Uses the globals $cache_dir (local cache), $out_dir (where the outputs go,
# defaults to $test_dir/outputs) and $base_dir (what is stripped from paths
# before hashing, defaults to $test_dir).
run_builder_with_cache() {
    local input=$1; shift
    local base_name="${input##*/}"
    local base_name="${base_name%.txt}"
    local out="${out_dir:-$test_dir/outputs}"
    local header="$out/$base_name.h"
    local object="$out/$base_name.o"
    mkdir -p "$out"

    cargo run --quiet --bin halide-cache -- \
        --dependencies "$HALIDE_TEST_DEPENDENCIES"/*.txt "$input" \
        --cache-dir "$cache_dir" --base-dir "${base_dir:-$test_dir}" "$@" \
        --generated-object "$object" --generated-header "$header" \
        -- "$builder" "$input" "$object" "$header" || die
}

# Usage: assert_output <file> <expected content>
assert_output() {
    [[ $(cat "$1") == "$2" ]] || die "wrong content in $1: expected '$2', got '$(cat "$1")'"
}

cache_dir="$test_dir/cache"

# Usage: assert_cache_entries <expected> <message> [dir]
assert_cache_entries() {
    local count=$(find "${3:-$cache_dir}" -type f -name '*.zst' | wc -l)
    (( $1 == count )) || die "expected != actual: %s != %s. Expectation %s" $1 $count "$2"
}

expected_count=0
base_output_content=''

# ---------- TESTS  ----------

base_case() {
    configure_output normal normal
    echo hello >"$test_dir/inputs/hello.txt"

    assert_cache_entries $expected_count

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    (( expected_count += 2 ))
    assert_cache_entries $expected_count "First entries to an empty cache"

    base_output_content="$(sha1sum "$test_dir/outputs/hello.o" "$test_dir/outputs/hello.h")"

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "No changes, cache hit"
}

difference_in_dependencies() {
    configure_output normal2 normal2 # Deps have changed but has no effect on output

    (( expected_count += 2 ))
    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "Dependencies have changed content but input and output hasn't"

    local output_content="$(sha1sum "$test_dir/outputs/hello.o" "$test_dir/outputs/hello.h")"
    [[ $output_content = $base_output_content ]] || die 'Hashes different but they shouldn not be'
}

uppercase() {
    configure_output uppercase normal

    (( expected_count += 2 ))

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "Dependencies and and output has changed"
    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "No change inputs and outputs => cache hit"
}

reverse_direction() {
    configure_output uppercase reverse

    ((expected_count += 2))

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "Dependencies have changed, affecting output"
    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "No change inputs and outputs => cache hit"
}

lowercase() {
    configure_output normal reverse

    ((expected_count += 2))

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "Dependencies have changed, affecting output"
    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "No change inputs and outputs => cache hit"
}

normal_direction() {
    configure_output normal normal

    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "Dependencies have changed, affecting output, but back to a previous case"
    run_builder_with_cache "$test_dir/inputs/hello.txt"
    assert_cache_entries $expected_count "No change inputs and outputs => cache hit"
}

input_path_different() {
    configure_output normal normal

    echo hello > "$test_dir/inputs/different.txt"
    ((expected_count += 2))
    run_builder_with_cache "$test_dir/inputs/different.txt"
    assert_cache_entries $expected_count "Path to input has changed"
}

input_content_different() {
    configure_output normal normal

    echo hello4 > "$test_dir/inputs/different.txt"
    ((expected_count += 2))
    run_builder_with_cache "$test_dir/inputs/different.txt"
    assert_cache_entries $expected_count "Content of input has changed"
}

# ---------- REMOTE TESTS ----------

server_pid=
server_dir="$test_dir/server"
server_url=
token=s3cret

# Usage: start_server [extra server args...]
#
# Runs the built binary directly rather than through `cargo run`, so that
# $server_pid is the server itself and stop_server really stops it.
start_server() {
    mkdir -p "$server_dir"
    cargo build --quiet -p halide-cache-server || die "cannot build the server"
    local target_dir
    target_dir=$(cargo metadata --format-version 1 --no-deps | sed 's/.*"target_directory":"\([^"]*\)".*/\1/')
    local server_bin="$target_dir/debug/halide-cache-server"
    [[ -x $server_bin ]] || die "server binary not found at $server_bin"
    # Pick a free port by binding to 0 is not possible from bash; try random ports.
    local port
    for _ in 1 2 3 4 5; do
        port=$(( 20000 + RANDOM % 20000 ))
        "$server_bin" \
            --listen "127.0.0.1:$port" --data-dir "$server_dir" --token "$token" \
            "$@" >>"$test_dir/server.log" 2>&1 &
        server_pid=$!
        server_url="http://127.0.0.1:$port"
        for _ in $(seq 50); do
            if curl -fs "$server_url/healthz" >/dev/null 2>&1; then
                return
            fi
            kill -0 "$server_pid" 2>/dev/null || break
            sleep 0.1
        done
        kill "$server_pid" 2>/dev/null; wait "$server_pid" 2>/dev/null
    done
    die "could not start halide-cache-server: $(cat "$test_dir/server.log")"
}

stop_server() {
    [[ -n $server_pid ]] || return 0
    kill "$server_pid" 2>/dev/null
    wait "$server_pid" 2>/dev/null
    # The port must really be closed, otherwise the outage test below would
    # talk to a survivor.
    curl -fs "$server_url/healthz" >/dev/null 2>&1 && die "server still answering after stop"
    server_pid=
}

trap stop_server EXIT

remote_populate() {
    configure_output normal normal
    echo remote >"$test_dir/inputs/remote.txt"
    cache_dir="$test_dir/cache_a"; mkdir -p "$cache_dir"

    run_builder_with_cache "$test_dir/inputs/remote.txt" --remote "$server_url" --remote-token "$token"
    assert_cache_entries 2 "Local cache populated" "$cache_dir"
    assert_cache_entries 2 "Server populated by upload" "$server_dir"
    base_output_content="$(sha1sum "$test_dir/outputs/remote.o" "$test_dir/outputs/remote.h")"
}

remote_hit_from_empty_local_cache() {
    cache_dir="$test_dir/cache_b"; mkdir -p "$cache_dir"
    rm -f "$test_dir/outputs/remote.o" "$test_dir/outputs/remote.h"

    local out
    out=$(run_builder_with_cache "$test_dir/inputs/remote.txt" --remote "$server_url")
    [[ $out == *"Remote cache hits"* ]] || die "expected a remote hit, got: $out"
    assert_cache_entries 2 "Remote hit stored locally" "$cache_dir"
    local output_content="$(sha1sum "$test_dir/outputs/remote.o" "$test_dir/outputs/remote.h")"
    [[ $output_content = $base_output_content ]] || die 'Outputs from remote differ from the originals'

    # Second run: local hit, remote untouched.
    out=$(run_builder_with_cache "$test_dir/inputs/remote.txt" --remote "$server_url")
    [[ $out == *"Cache hits"* && $out != *"Remote"* ]] || die "expected a local hit, got: $out"
}

remote_read_only_does_not_upload() {
    cache_dir="$test_dir/cache_c"; mkdir -p "$cache_dir"
    echo readonly >"$test_dir/inputs/readonly.txt"

    run_builder_with_cache "$test_dir/inputs/readonly.txt" --remote "$server_url" --remote-token "$token" --remote-read-only
    assert_cache_entries 2 "Built locally" "$cache_dir"
    assert_cache_entries 2 "Read-only client did not upload" "$server_dir"
}

remote_upload_without_token_is_rejected_but_build_succeeds() {
    cache_dir="$test_dir/cache_d"; mkdir -p "$cache_dir"
    echo notoken >"$test_dir/inputs/notoken.txt"

    local err
    err=$(run_builder_with_cache "$test_dir/inputs/notoken.txt" --remote "$server_url" 2>&1 >/dev/null)
    [[ $err == *"upload to remote failed"* ]] || die "expected an upload warning, got: $err"
    assert_cache_entries 2 "Built locally" "$cache_dir"
    assert_cache_entries 2 "Unauthorised upload rejected" "$server_dir"
}

remote_down_falls_back_to_build() {
    stop_server
    cache_dir="$test_dir/cache_e"; mkdir -p "$cache_dir"

    local err
    err=$(run_builder_with_cache "$test_dir/inputs/remote.txt" --remote "$server_url" 2>&1 >/dev/null)
    [[ $err == *"remote lookup failed"* ]] || die "expected a lookup warning, got: $err"
    assert_cache_entries 2 "Built locally although the server is down" "$cache_dir"
}

# Unfortunately the order of these matter
base_case
difference_in_dependencies
uppercase
reverse_direction
lowercase
normal_direction
input_path_different
input_content_different

start_server --evict-interval 3600
remote_populate
remote_hit_from_empty_local_cache
remote_read_only_does_not_upload
remote_upload_without_token_is_rejected_but_build_succeeds
remote_down_falls_back_to_build
echo "All tests passed"
